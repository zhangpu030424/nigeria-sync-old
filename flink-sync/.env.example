# 复制为 .env 后填写（勿提交含密码的 .env）
# cp .env.example .env

FLINK_WEB_PORT=8090
FLINK_JOBMANAGER_CONTAINER=ng-sync-flink-jobmanager

# ========== Flink 资源 ==========
FLINK_TASK_SLOTS=16
FLINK_TM_MEMORY=28672m
FLINK_PARALLELISM=4
FLINK_PARALLELISM_BULK=16
FLINK_PARALLELISM_INCR=2
FLINK_PARALLELISM_INCR_LIGHT=2
FLINK_PARALLELISM_INCR_HEAVY=4
FLINK_PARALLELISM_INCR_USER_INFO=4
FLINK_PARALLELISM_INCR_APPLICATION=4
FLINK_PARALLELISM_INCR_LOAN=4
FLINK_MINI_BATCH_SIZE=5000
FLINK_SINK_BUFFER_ROWS=10000
FLINK_CDC_CHUNK_SIZE=200000
FLINK_CDC_FETCH_SIZE=20000
FLINK_SINK_MAX_RETRIES=15
FLINK_JDBC_RETRY_TIMEOUT=120s
FLINK_CHECKPOINT_INTERVAL=300s
FLINK_CHECKPOINT_TIMEOUT=1800s
LOOKUP_CACHE_TTL=30s

# 增量 CDC 启动：initial=先快照补漏再追 binlog；latest-offset=只追新变更
CDC_STARTUP_MODE=initial
# CDC_STARTUP_MODE=timestamp
# CDC_STARTUP_TIMESTAMP_MILLIS=0

