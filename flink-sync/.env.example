MARKET_MYSQL_HOST=10.52.139.200
MARKET_MYSQL_PORT=3306
MARKET_MYSQL_USER=flink_cdc
MARKET_MYSQL_PASSWORD=change_me
MARKET_MYSQL_DATABASE=ng_loan_market

# ========== 源库 ng_loan_core（核心）==========
CORE_MYSQL_HOST=10.52.139.200
CORE_MYSQL_PORT=3306
CORE_MYSQL_USER=flink_cdc
CORE_MYSQL_PASSWORD=change_me
